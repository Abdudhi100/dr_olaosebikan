# Default disabled creates an honest, unindexed empty hub. No CMS query occurs.
SANITY_CONTENT_MODE=disabled
# Enable sanity mode only after the owner provisions and verifies the project.
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# Private datasets only: build-only read token. Never prefix NEXT_PUBLIC_.
# SANITY_API_READ_TOKEN=
