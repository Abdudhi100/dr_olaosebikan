# Confirmed Sanity owner project; public production dataset is used for published-only editorial content.
# Set these values in Cloudflare Pages Preview and (after launch approval) Production environments.
SANITY_CONTENT_MODE=sanity
SANITY_PROJECT_ID=zavdffj8
SANITY_DATASET=production
# Public published queries need no token. For PRIVATE datasets only,
# provision a build-only read token; never prefix a token NEXT_PUBLIC_.
# SANITY_API_READ_TOKEN=
