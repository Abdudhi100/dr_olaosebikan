{
  "name": "doctor_project",
  "version": "1.0.0",
  "description": "Static Next.js clinic website for Dr Olaosebikan.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-static-export.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/prepare-editorial.mjs",
    "prebuild": "node scripts/prepare-editorial.mjs",
    "pretypecheck": "node scripts/prepare-editorial.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "test:export": "node scripts/verify-editorial-export.mjs"
  },
  "keywords": [
    "clinic",
    "rheumatology",
    "nextjs",
    "cloudflare-pages"
  ],
  "author": "Dr Olaosebikan Clinic",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
